NODE_ENV=development
PORT=5000

# Development database; never point this at production
MONGO_DEV_URI=mongodb://127.0.0.1:27017/school-erp-dev?replicaSet=rs0

# Dedicated test database; must be a replica set (local or Atlas)
MONGO_TEST_URI=mongodb://127.0.0.1:27017/school-erp-test?replicaSet=rs0

# Production database; configure only in the production secret manager
MONGO_URI=

REDIS_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

WEB_URL=
