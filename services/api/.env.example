NODE_ENV=development
PORT=5000

# Development database; never point this at production
MONGO_DEV_URI=mongodb://127.0.0.1:27017/school-erp-dev?replicaSet=rs0

# Dedicated test database; must be a replica set (local or Atlas)
MONGO_TEST_URI=mongodb://127.0.0.1:27017/school-erp-test?replicaSet=rs0

# Production database; configure only in the production secret manager
MONGO_URI=

REDIS_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

WEB_URL=

# Cloudinary document uploads (keep API secret server-side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Guardian communication providers (keep all credentials server-side)
# MSG91 SMS Flow must be mapped to your approved DLT content template.
MSG91_AUTH_KEY=
MSG91_SMS_FLOW_ID=
MSG91_SMS_SENDER_ID=
# Exact variable name configured in the MSG91 Flow (case-sensitive).
MSG91_SMS_MESSAGE_VARIABLE=message
# Optional webhook shared secret; append ?token=<value> to the callback URL in MSG91.
MSG91_WEBHOOK_SECRET=

# Twilio remains the WhatsApp provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# WhatsApp sender: E.164 number; the API adds the required "whatsapp:" prefix.
# For the sandbox, use the sender shown in your Twilio WhatsApp Sandbox settings.
TWILIO_WHATSAPP_FROM=

# Approved Twilio Content Template SID (starts with HX).
# Current integration sends the message as template variable {{1}}.
TWILIO_WHATSAPP_CONTENT_SID=

# Public HTTPS endpoint configured in Twilio for message status callbacks.
# Example: https://api.example.com/api/v1/webhooks/twilio/status
# Keep this URL identical to the Twilio Console callback URL.
TWILIO_STATUS_CALLBACK_URL=

# Resend email provider
RESEND_API_KEY=
COMMUNICATION_FROM_EMAIL=
